# --- Приём заявок (сервер, НЕ попадает во фронтенд) ---
# Нужен хотя бы один канал доставки. Без них /api/lead отвечает 503,
# а сайт честно показывает ошибку, а не «отправлено».

# Универсальный webhook (Google Apps Script, Make, n8n, CRM и т.п.): получает JSON с заявкой
LEAD_WEBHOOK_URL=
# Необязательно: отправляется в заголовке X-Webhook-Secret
LEAD_WEBHOOK_SECRET=

# Уведомление организатору в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Лимит заявок с одного IP: сколько за окно (сек.)
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_SEC=600

# --- Фронтенд (публичные значения) ---
# Показывать заглушки (подрядчики, FAQ, розыгрыш) в тестовой сборке. На публичном сайте НЕ включать.
VITE_PREVIEW_PLACEHOLDERS=false
